---
import { SEO } from "astro-seo";
import { ViewTransitions } from "astro:transitions";
import "../styles/main.css";

import Navbar from "../components/Navbar.astro";
import Header from "../components/Header.astro";
import Stack from "../components/Stack.astro";
import DownArrow from "../components/DownArrow.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Blur from "../components/Blur.astro";
---

<script>
  import { loadGSAP, createObserver } from "../utils/gsap-loader.js";

  document.addEventListener("DOMContentLoaded", async () => {
    const projectsSection = document.getElementById("projects-section");
    if (!projectsSection) return;

    // Mostrar inmediatamente en móvil
    if (window.innerWidth <= 768) {
      projectsSection.style.opacity = "1";
      return;
    }

    // Cargar GSAP solo en desktop con Intersection Observer
    const gsapModules = await loadGSAP();
    if (!gsapModules) {
      projectsSection.style.opacity = "1";
      return;
    }

    const { gsap } = gsapModules;

    const observer = createObserver((entries: any) => {
      entries.forEach((entry: any) => {
        if (entry.isIntersecting) {
          gsap.fromTo(
            "#projects-section",
            { y: "20%", opacity: 0, filter: "blur(20px)" },
            {
              y: "0%",
              opacity: 1,
              filter: "blur(0px)",
              duration: 1.5,
              ease: "power4.out",
            },
          );
          observer.unobserve(entry.target);
        }
      });
    });

    observer.observe(projectsSection);
  });
</script>

<html lang="en" transition:animate="slide">
  <head>
    <meta charset="utf-8" />
    <style>
      /* Critical CSS inline for immediate LCP */
      #heading h2 {
        font-family:
          "Eudoxus Sans",
          system-ui,
          -apple-system,
          sans-serif !important;
        font-weight: 700;
        color: transparent;
        -webkit-text-stroke: 2px #222630;
        transform: skew(-2deg);
        font-size: clamp(2.25rem, 8vw, 3.75rem);
        line-height: 1;
        margin: 0;
        text-wrap: nowrap;
        will-change: transform;
        font-display: block;
      }
      @media (min-width: 769px) {
        #heading h2 {
          opacity: 1 !important;
        }
      }
      @media (prefers-color-scheme: dark) {
        #heading h2 {
          -webkit-text-stroke-color: #ededed;
        }
      }
    </style>
    <SEO
      title="Bautista Igarzabal"
      description="Portfolio personal"
      openGraph={{
        basic: {
          title: "Bautista Igarzabal",
          type: "website",
          image: "https://avatars.githubusercontent.com/u/68351913",
        },
      }}
      twitter={{
        creator: "@aka.bbauti",
      }}
      extend={{
        // extending the default link tags
        link: [
          { rel: "icon", href: "/favicon.ico" },
          { rel: "sitemap", href: "/sitemap-index.xml" },
          {
            rel: "preload",
            href: "/fonts/EudoxusSans-Bold.woff2",
            as: "font",
            type: "font/woff2",
            crossorigin: "anonymous",
          },
          {
            rel: "preload",
            href: "/fonts/InterVariable.ttf",
            as: "font",
            type: "font/ttf",
            crossorigin: "anonymous",
          },
          {
            rel: "preconnect",
            href: "https://fonts.gstatic.com",
            crossorigin: "anonymous",
          },
        ],
        // extending the default meta tags
        meta: [
          {
            name: "twitter:image",
            content: "https://avatars.githubusercontent.com/u/68351913",
          },
          { name: "twitter:title", content: "Bautista Igarzabal" },
          { name: "twitter:description", content: "Portfolio" },
          { name: "theme-color", content: "#ffffff" },
        ],
      }}
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <ViewTransitions />
  </head>
  <body>
    <Blur />
    <!-- <Socials /> -->
    <Navbar />
    <main class="shadow-xl relative">
      <section class="relative pb-[4rem] lg:pb-[2rem] p-[2rem]">
        <Header />
        <Stack />
        <DownArrow />
      </section>
      <Projects />
      <Contact />
    </main>
    <Footer />

    <style>
      * {
        transition:
          opacity 0.1s ease-in-out,
          transform 0.1s ease-in-out;
      }

      @font-face {
        font-family: "Inter";
        src: url("/fonts/InterVariable.ttf") format("truetype-variations");
        font-weight: 1 999;
        font-display: block;
      }

      @font-face {
        font-family: "Eudoxus Sans";
        src: url("/fonts/EudoxusSans-Bold.woff2") format("woff2");
        font-display: block;
        font-weight: 700;
        font-style: normal;
      }

      @font-face {
        font-family: "Geist Mono";
        src: url("/fonts/GeistMonoVF.ttf") format("truetype-variations");
        font-weight: 1 999;
        font-display: swap;
      }

      body {
        font-family: "Inter";
      }

      section {
        overflow: hidden;
        border-radius: 2rem;
        margin-bottom: 2rem;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background-color: #fff;
      }

      main {
        position: relative;
        z-index: 1;
        color: #222630;
        background-color: #fff;
        min-height: 100%;
        margin: 0;
        padding: 2rem;
        font-size: 16px;
        letter-spacing: -0.0075rem;
        font-family: Inter, sans-serif;
        font-weight: 400;
        line-height: 24px;
      }

      @keyframes grain {
        0%,
        to {
          transform: translate(0);
        }

        10% {
          transform: translate(-5%, -10%);
        }

        20% {
          transform: translate(-15%, 5%);
        }

        30% {
          transform: translate(7%, -25%);
        }

        40% {
          transform: translate(-5%, 25%);
        }

        50% {
          transform: translate(-15%, 10%);
        }

        60% {
          transform: translate(15%);
        }

        70% {
          transform: translateY(15%);
        }

        80% {
          transform: translate(3%, 35%);
        }

        90% {
          transform: translate(-10%, 10%);
        }
      }

      @media (max-width: 768px) {
        main {
          padding: 1rem;
        }
      }

      .wrapper {
        mask-image: radial-gradient(
          ellipse at 100% 0%,
          black 40%,
          transparent 70%
        );
        -webkit-mask-image: radial-gradient(
          ellipse at 100% 0%,
          black 40%,
          transparent 70%
        );
      }

      .stripes {
        transform: translate3d(0, 0, 0);
        --bg: currentcolor;
        --duration: 60s;
        --stripes: repeating-linear-gradient(
          120deg,
          white 0%,
          white 7%,
          transparent 10%,
          white 12%,
          white 16%
        );
        /* --rainbow: repeating-linear-gradient(
          120deg,
          #ff00b3 10%,
          #6517f7 25%,
          #4665ef 50%,
          #f65c8a 75%,
          #00f7ff 90%
        ); */
        --rainbow: repeating-linear-gradient(120deg, transparent, transparent);
        background-image: var(--stripes), var(--rainbow);
        background-size: 120%, 200%;
        background-position:
          50% 50%,
          50% 50%;
      }

      /* Dark mode */

      :global(.dark) {
        body {
          background-color: #0c0c0c;
        }

        main {
          color: #ededed;
          background-color: #0c0c0c;
        }

        #noise {
          opacity: 0.04;
        }
      }
    </style>
  </body>
</html>
