    <meta name="generator" content={Astro.generator} />
    <SchemaOrg
      name="Bautista Igarzabal"
      jobTitle="Frontend Engineer"
      description="Frontend engineer specialized in Vue, Nuxt and TypeScript."
      url="https://bbauti.ar"
      image="https://avatars.githubusercontent.com/u/68351913"
      email="bautistaigarzabal11@gmail.com"
      sameAs={[
        "https://www.linkedin.com/in/bbauti",
        "https://github.com/bbauti"
      ]}
      projects={[
        {
          name: "Iberojet",
          description: "Airline flight-booking website built with Vue 3 and Nuxt 3",
          url: "https://iberojet.com/",
          image: "https://bbauti.ar/projects/iberojet.webp",
          technologies: ["Vue", "Nuxt", "TypeScript"]
        },
        {
          name: "PlanB",
          description: "Experiences booking platform and back-office",
          url: "https://planb.es/",
          image: "https://bbauti.ar/projects/planb.webp",
          technologies: ["Vue", "Nuxt", "TypeScript"]
        },
        {
          name: "Punto Bazar",
          description: "Inventory and sales dashboard",
          url: "https://github.com/bbauti/dashboard",
          image: "https://bbauti.ar/projects/dashboard.webp",
