---
import { SEO } from "astro-seo";
import { ViewTransitions } from "astro:transitions";
import "../styles/main.css";

import Navbar from "../components/Navbar.astro";
import Header from "../components/Header.astro";
import Stack from "../components/Stack.astro";
import DownArrow from "../components/DownArrow.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Blur from "../components/Blur.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
---

<script>
  import { loadGSAP, createObserver } from "../utils/gsap-loader.js";

  document.addEventListener("DOMContentLoaded", async () => {
    const projectsSection = document.getElementById("projects-section");
    if (!projectsSection) return;

    // Mostrar inmediatamente en móvil
    if (window.innerWidth <= 768) {
      projectsSection.style.opacity = "1";
      return;
    }

    // Cargar GSAP solo en desktop con Intersection Observer
    const gsapModules = await loadGSAP();
    if (!gsapModules) {
      projectsSection.style.opacity = "1";
      return;
    }

    const { gsap } = gsapModules;

    const observer = createObserver((entries: any) => {
      entries.forEach((entry: any) => {
        if (entry.isIntersecting) {
          gsap.fromTo(
            "#projects-section",
            { y: "20%", opacity: 0, filter: "blur(20px)" },
            {
              y: "0%",
              opacity: 1,
              filter: "blur(0px)",
              duration: 1.5,
              ease: "power4.out",
            },
          );
          observer.unobserve(entry.target);
        }
      });
    });

    observer.observe(projectsSection);
  });
</script>

<html lang="en" transition:animate="slide">
  <head>
    <meta charset="utf-8" />
    <style>
      /* Critical CSS inline for immediate LCP */
      #heading h1 {
        font-family:
          "Eudoxus Sans",
          system-ui,
          -apple-system,
          sans-serif !important;
        font-weight: 700;
        color: transparent;
        -webkit-text-stroke: 2px #222630;
        transform: skew(-2deg);
        font-size: clamp(2.25rem, 8vw, 3.75rem);
        line-height: 1;
        margin: 0;
        text-wrap: nowrap;
        will-change: transform;
        font-display: block;
      }
      @media (min-width: 769px) {
        #heading h1 {
          opacity: 1 !important;
        }
      }
      @media (prefers-color-scheme: dark) {
        #heading h1 {
          -webkit-text-stroke-color: #ededed;
        }
      }
    </style>
    <SEO
      title="Bautista Igarzabal | Frontend Engineer"
      description="Frontend engineer specialized in Vue, Nuxt and TypeScript. Primary frontend engineer of Iberojet's flight-booking platform. Remote from Buenos Aires, Argentina."
      canonical="https://bbauti.ar/"
      openGraph={{
        basic: {
          title: "Bautista Igarzabal | Frontend Engineer",
          type: "website",
          image: "https://bbauti.ar/og-image.png",
          url: "https://bbauti.ar/",
        },
        optional: {
          siteName: "Bautista Igarzabal Portfolio",
          locale: "en_US",
          description: "Frontend engineer specialized in Vue, Nuxt and TypeScript. Primary frontend engineer of Iberojet's flight-booking platform. Remote from Buenos Aires, Argentina.",
