            href: "/fonts/EudoxusSans-Bold.woff2",
            as: "font",
            type: "font/woff2",
            crossorigin: "anonymous",
          },
          {
            rel: "preload",
            href: "/fonts/InterVariable.ttf",
            as: "font",
            type: "font/ttf",
            crossorigin: "anonymous",
          },
          { rel: "dns-prefetch", href: "https://avatars.githubusercontent.com" },
          { rel: "dns-prefetch", href: "https://github.com" },
        ],
        meta: [
          { name: "author", content: "Bautista Igarzabal" },
          { name: "robots", content: "index, follow" },
          { name: "googlebot", content: "index, follow" },
          { name: "theme-color", content: "#ffffff" },
          { name: "keywords", content: "frontend engineer, vue developer, nuxt developer, typescript, remote, argentina, bautista igarzabal" },
          { name: "geo.region", content: "AR" },
