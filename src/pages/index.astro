        image: "https://bbauti.ar/og-image.png",
        imageAlt: "Bautista Igarzabal Portfolio",
      }}
      extend={{
        link: [
          { rel: "icon", href: "/favicon.ico" },
          { rel: "sitemap", href: "/sitemap-index.xml" },
          {
