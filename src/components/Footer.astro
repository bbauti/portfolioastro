---
import { Icon } from "astro-icon/components";
---

<footer
  class="sticky bottom-0 flex min-h-[50dvh] items-center bg-[#222630]"
  role="contentinfo"
  aria-label="Pie de pagina"
>
  <div class="absolute inset-0 -z-1 overflow-hidden">
    <div
      class="absolute top-1/2 left-1/2 h-full min-h-108 w-full min-w-3xl -translate-x-1/2 -translate-y-1/2"
    >
      <div class="wrapper absolute inset-0">
        <div class="absolute inset-0 overflow-hidden">
          <div
            class="stripes pointer-events-none absolute -inset-2.5 overflow-hidden text-white opacity-30 blur-[15px] invert transition-opacity duration-500 dark:text-black dark:invert-0"
          >
            <div
              class="animate-god-rays absolute h-full w-[300%] mix-blend-difference"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="gradient"></div>
  <section class="flex w-full justify-between px-12 py-8">
    <div class="flex flex-col justify-center text-[#f3f3f3]">
      <span class="text-2xl font-[700] tracking-wider italic"> bbauti </span>
      <a
        href="https://github.com/bbauti/portfolioastro"
        aria-label="Ver codigo fuente en GitHub"
        class="flex items-center gap-2"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="mdi:github" />
        <span class="mb-[.3rem]">source</span>
      </a>
    </div>

    <nav class="flex flex-col justify-center gap-4 text-[#f3f3f3]" aria-label="Enlaces de contacto">
      <p class="text-sm font-bold uppercase" id="contact-nav-heading">Contactame</p>
      <ul class="socials flex flex-col gap-0.5" aria-labelledby="contact-nav-heading">
        <li>
          <a
            href="https://www.linkedin.com/in/bbauti"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-full items-center justify-between gap-2"
            aria-label="Visitar perfil de LinkedIn">Linkedin<Icon name="mdi:arrow-right" class="rotate-[-45deg] transform transition-all ease-in-out group-hover:rotate-0" /></a
          >
        </li>
        <li>
          <a
            href="mailto:bautistaigarzabal11@gmail.com"
            class="group flex w-full items-center justify-between gap-2"
            aria-label="Enviar email">Email<Icon name="mdi:arrow-right" class="rotate-[-45deg] transform transition-all ease-in-out group-hover:rotate-0" /></a
          >
        </li>
        <li>
          <a
            href="https://x.com/akabbauti"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-full items-center justify-between gap-2"
            aria-label="Visitar perfil de Twitter">Twitter<Icon name="mdi:arrow-right" class="rotate-[-45deg] transform transition-all ease-in-out group-hover:rotate-0" /></a
          >
        </li>
        <li>
          <a
          href="https://github.com/bbauti"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex w-full items-center justify-between gap-2"
          aria-label="Visitar perfil de GitHub">Github<Icon name="mdi:arrow-right" class="rotate-[-45deg] transform transition-all ease-in-out group-hover:rotate-0" /></a
          >
        </li>
        <li class="hidden">
          <a
            href="https://read.cv/bbauti"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-full items-center justify-between gap-2"
            aria-label="Ver curriculum">CV<Icon name="mdi:arrow-right" class="rotate-[-45deg] transform transition-all ease-in-out group-hover:rotate-0" /></a
          >
        </li>
        <li>
          <a
            href="https://www.behance.net/bbauti"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-full items-center justify-between gap-2"
            aria-label="Visitar perfil de Behance">Behance<Icon name="mdi:arrow-right" class="rotate-[-45deg] transform transition-all ease-in-out group-hover:rotate-0" /></a
          >
        </li>
      </ul>
    </nav>
  </section>
  <div class="gradient-bottom"></div>
</footer>

<style>
  .gradient {
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(228, 75, 233, 0.089) 0%,
      rgba(230, 230, 230, 0) 100%
    );
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 200px;
  }

  .gradient-bottom {
    pointer-events: none;
    background: linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.089) 0%,
      rgba(230, 230, 230, 0) 100%
    );
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
  }

  .wrapper {
    mask-image: radial-gradient(ellipse at 0% 0%, black 40%, transparent 70%);
    -webkit-mask-image: radial-gradient(
      ellipse at 0% 0%,
      black 40%,
      transparent 70%
    );
  }

  .stripes {
    transform: translate3d(0, 0, 0);
    --bg: currentcolor;
    --duration: 60s;
    --stripes: repeating-linear-gradient(
      60deg,
      var(--bg) 0%,
      var(--bg) 7%,
      transparent 10%,
      transparent 12%,
      var(--bg) 16%
    );
    --rainbow: repeating-linear-gradient(
      60deg,
      #f5f5f5 10%,
      #f7e017 25%,
      #d946ef 50%,
      #8b5cf6 75%,
      #f5f5f5 90%
    );
    background-image: var(--stripes), var(--rainbow);
    background-size: 120%, 200%;
    background-position:
      50% 50%,
      50% 50%;
  }

  .animate-god-rays {
    background-image: var(--stripes), var(--rainbow);
    background-size: 100%, 100%;
    background-position: 50% 50%;
    animation: god-rays var(--duration) cubic-bezier(0.15, 0, 0.85, 1) infinite
      alternate;
  }

  @keyframes god-rays {
    0% {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
</style>
