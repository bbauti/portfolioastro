---
import { Icon } from "astro-icon/components";
---

<nav
  class="absolute top-8 right-0 z-50 mr-8 flex w-fit justify-between max-sm:left-1/2 max-sm:mr-0 max-sm:-translate-x-1/2"
  role="navigation"
  aria-label="Enlaces sociales y de contacto"
>
  <ul class="font-500 flex gap-4 text-[#000000b8] dark:text-[#ffffffb8]">
    <li class="transition-all duration-200 ease-in-out hover:origin-bottom-left hover:rotate-[5deg] hover:text-black dark:hover:text-white">
      <a
        href="https://www.linkedin.com/in/bbauti"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar perfil de LinkedIn"
      >
        <Icon name="mdi:linkedin" class="block h-6 w-6 sm:hidden" />
        <span class="hidden sm:block">Linkedin</span>
      </a>
    </li>
    <li class="transition-all duration-200 ease-in-out hover:origin-bottom-left hover:rotate-[5deg] hover:text-black dark:hover:text-white">
      <a
        href="mailto:bautistaigarzabal11@gmail.com"
        aria-label="Enviar email"
      >
        <Icon name="mdi:email" class="block h-6 w-6 sm:hidden" />
        <span class="hidden sm:block">Email</span>
      </a>
    </li>
    <li class="transition-all duration-200 ease-in-out hover:origin-bottom-left hover:rotate-[5deg] hover:text-black dark:hover:text-white">
      <a href="https://x.com/akabbauti" target="_blank" rel="noopener noreferrer" aria-label="Visitar perfil de Twitter">
        <Icon name="mdi:twitter" class="block h-6 w-6 sm:hidden" />
        <span class="hidden sm:block">Twitter</span>
      </a>
    </li>
    <li class="transition-all duration-200 ease-in-out hover:origin-bottom-left hover:rotate-[5deg] hover:text-black dark:hover:text-white">
      <a href="https://github.com/bbauti" target="_blank" rel="noopener noreferrer" aria-label="Visitar perfil de GitHub">
        <Icon name="mdi:github" class="block h-6 w-6 sm:hidden" />
        <span class="hidden sm:block">Github</span>
      </a>
    </li>
    <li class="transition-all duration-200 ease-in-out hover:origin-bottom-left hover:rotate-[5deg] hover:text-black dark:hover:text-white">
      <a href="https://drive.google.com/file/d/1vSYV466x-Ql2hqlsNacD7AdpCSOa2GE7/view" target="_blank" rel="noopener noreferrer" aria-label="Descargar curriculum">
        <Icon name="ph:read-cv-logo-fill" class="block h-6 w-6 sm:hidden" />
        <span class="hidden sm:block">Resume</span>
      </a>
    </li>
    <li class="transition-all duration-200 ease-in-out hover:origin-bottom-left hover:rotate-[5deg] hover:text-black dark:hover:text-white">
      <a
        href="https://www.behance.net/bbauti"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar perfil de Behance"
      >
        <Icon name="ph:behance-logo-fill" class="block h-6 w-6 sm:hidden" />
        <span class="hidden sm:block">Behance</span>
      </a>
    </li>
  </ul>
</nav>
