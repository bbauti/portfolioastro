---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import * as colores from "../../public/colors.json";

import type { ImageMetadata } from "astro";

type Colores = { [key: string]: string };

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{jpeg,jpg,png,gif,webp}",
);

const typedColores = colores as Colores;

let projects = [
  {
    name: ["Iberojet"],
    desc: "Lideré la reconstrucción del frontend de la plataforma de viajes de Iberojet utilizando Vue 3 y Nuxt 3 con TypeScript. El proyecto incluyó un panel de control de operaciones de vuelo en tiempo real, un CMS multilingüe y características complejas como selectores de asientos y procesamiento de pagos. Optimicé el rendimiento e implementé una arquitectura multidominio que atiende a varios mercados internacionales, demostrando mi capacidad para entregar soluciones frontend complejas a gran escala.",
    year: "2024 - Actualidad",
    source: "",
    img: "/src/assets/projects/iberojet.webp",
    link: "https://iberojet.com/",
    status: "done",
    languagesColor: ["Vue", "TypeScript", "JavaScript", "HTML", "CSS", "Vue"],
    languages: ["Vue", "TS", "JS", "HTML", "CSS", "Nuxt"],
  },
  {
    name: ["Planb"],
    desc: "Lideré el desarrollo del frontend de PlanB, plataforma de reserva de experiencias y estancias, utilizando Vue 3 y Nuxt 3 con TypeScript. El proyecto incluyó un CMS multilingüe, un sistema de reservas adaptativo con calendario interactivo y personalización de paquetes. Optimicé la carga inicial mediante lazy loading y pre‑renderizado, demostrando mi capacidad para entregar interfaces frontend avanzadas y de alto rendimiento.",
    year: "2024 - Actualidad",
    source: "",
    img: "/src/assets/projects/planb.webp",
    link: "https://planb.es/",
    status: "done",
    languagesColor: ["Vue", "TypeScript", "JavaScript", "HTML", "CSS", "Vue"],
    languages: ["Vue", "TS", "JS", "HTML", "CSS", "Nuxt"],
  },
  {
    name: ["Punto Bazar"],
    desc: "Aplicación de gestión de inventario para la diplomatura de programación de la UTN. La aplicación permite gestionar stock, crear productos, manejar un carrito de compras con cálculos de precios, impuestos y envíos, analizar transacciones, gestionar impuestos, y administrar múltiples cuentas. Cuenta con notificaciones de bajo stock y es de código abierto.",
    year: "2023",
    source: "https://github.com/bbauti/dashboard",
    img: "/src/assets/projects/dashboard.webp",
    link: "https://dash.bbauti.ar/",
    status: "done",
    languagesColor: ["HTML", "CSS", "SCSS", "JavaScript", "Svelte", "Vite"],
    languages: ["HTML", "CSS", "SCSS", "JS", "Svelte", "Vite"],
  },
  {
    name: ["Inventory App", "1rem"],
    desc: "Aplicación web para el control del inventario de una institución escolar. Fui responsable del frontend, la documentación y las tareas de DevOps. La aplicación, implementada en un servidor propio con CI/CD para actualizaciones automáticas, permitía a los maestros controlar el inventario escolar y localizar objetos en diferentes salones. Todo se creó desde cero, incluyendo correos y autenticación. Se uso la metodologia SCRUM.",
    year: "2022",
    source: "https://bitbucket.org/arrudeboy/inventory/src",
    img: "/src/assets/projects/inventoryapp.webp",
    link: "",
    status: "wip",
    languagesColor: [
      "Python",
      "Python",
      "Jinja2",
      "JavaScript",
      "HTML",
      "CSS",
      "SQL",
    ],
    languages: ["PY", "Flask", "Jinja2", "JS", "HTML", "CSS", "SQL"],
  } /*
  {
    name: ["Todo App"],
    desc: "Pagina web para gestionar tareas con el uso de localStorage.",
    source: "https://github.com/bbauti/p5todoapp",
    img: "todoapp",
    link: "https://bbauti.github.io/p5todoapp",
    status: "done",
    languagesColor: ["HTML", "CSS", "JavaScript"],
    languages: ["HTML", "CSS", "JS"],
  },
  {
    name: ["Weather Channel"],
    desc: "Pagina web para obtener informacion sobre el clima.",
    source: "https://github.com/bbauti/p5weatherChannel",
    img: "weatherchannel",
    link: "https://bbauti.github.io/p5weatherChannel",
    status: "done",
    languagesColor: ["HTML", "CSS", "JavaScript"],
    languages: ["HTML", "CSS", "JS"],
  },
  {
    name: ["Color Game"],
    desc: "Juego sobre adivinar un color en formato rgb, con cuadrados de colores aleatorios.",
    source: "https://github.com/bbauti/p5colorgame",
    img: "colorgame",
    link: "https://bbauti.github.io/p5colorgame",
    status: "done",
    languagesColor: ["HTML", "CSSimagePath", "JavaScript"],
    languages: ["HTML", "CSS", "JS"],
  }, */,
];

const checkColor = (lang: keyof Colores): string => {
  const color = typedColores[lang];
  return color ? color : "#fff";
};
---

<section class="mb-8" id="projects-section" aria-labelledby="projects-heading">
  <h2
    id="projects-heading"
    class="relative mx-auto mb-4 w-fit text-lg font-semibold md:text-xl"
  >
    Proyectos destacados
  </h2>
  <div id="cards" class="flex w-full flex-col items-center gap-4" role="list">
    {
      projects.map((project) => (
        <article
          class="h-fit w-fit overflow-hidden rounded-[30px] transition-all ease-in-out hover:shadow-xl"
          role="listitem"
        >
          <div class="relative mx-auto flex h-full w-full max-w-[1000px] flex-col justify-between gap-4 rounded-[30px] bg-[#f5f5f5] p-[0.8rem] shadow-project-outline md:flex-row dark:bg-[#121212] dark:shadow-project-outline-dark">
            <div class="flex w-full flex-col gap-2 p-[1rem] md:max-w-[34ch]">
              <header class="flex items-center gap-2 text-xl font-[600] select-none">
                <h3 class="ptitle">{project.name[0]}</h3>
                <div class="flex items-center gap-2">
                  {project.source && (
                    <div class="icon-card rounded-md bg-[#AFAFAF]/10 p-1 transition-all ease-in-out hover:-translate-y-[1px] hover:bg-[#AFAFAF]/40 dark:bg-[#4A4A4A]/10 dark:hover:bg-[#4A4A4A]/40">
                      <a
                        href={project.source}
                        class="git"
                        aria-label={`Ver codigo fuente de ${project.name[0]}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon name="mdi:git" />
                      </a>
                    </div>
                  )}
                  {project.status === "done" && (
                    <div class="icon-card icon-card-text hover:color-[#AFAFAF] dark:hover:color-[#4A4A4A] rounded-md bg-[#AFAFAF]/10 p-1 transition-all ease-in-out hover:-translate-y-[1px] dark:bg-[#4A4A4A]/10">
                      <a
                        href={project.link}
                        aria-label={`Visitar ${project.name[0]}`}
                        class="done"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon name="mdi:external-link" />
                      </a>
                    </div>
                  )}
                  {project.status === "wip" && (
                    <div
                      class="icon-card disabled rounded-md bg-[#AFAFAF]/10 p-1 dark:bg-[#4A4A4A]/10"
                      role="img"
                      aria-label="Proyecto en desarrollo"
                    >
                      <Icon name="mdi:construction" aria-hidden="true" />
                    </div>
                  )}
                </div>
                <p class="ml-auto rounded-md bg-black/10 px-2 py-1 text-xs font-semibold opacity-50">
                  {project.year}
                </p>
              </header>
              <div
                class="flex flex-wrap gap-1 select-none"
                role="list"
                aria-label="Tecnologias usadas"
              >
                {project.languages.map((lang, index) => (
                  <div
                    class="flex items-center justify-center gap-1 rounded-lg border border-white/20 px-2 text-sm shadow-sm dark:border-black/20"
                    style={{
                      backgroundColor:
                        checkColor(project.languagesColor[index]) + "50",
                    }}
                    role="listitem"
                  >
                    <span
                      class="langColor"
                      style={{
                        color: checkColor(project.languagesColor[index]),
                      }}
                      aria-hidden="true"
                    >
                      ●
                    </span>
                    <span class="lang">{lang}</span>
                  </div>
                ))}
              </div>
              <div class="select-none">
                <p class="leading-[1.325] tracking-wide">{project.desc}</p>
              </div>
            </div>
            <figure class="my-auto h-fit w-fit">
              <Image
                src={images[project.img]()}
                alt={`Captura de pantalla del proyecto ${project.name[0]}`}
                class="relative z-50 ml-auto max-h-full rounded-[25px] border border-gray-300 p-[0.1rem] dark:border-gray-600"
                width={500}
                height={375}
                densities={[1, 2]}
                loading="lazy"
                decoding="async"
                quality={80}
                format="webp"
              />
            </figure>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  #projects-section {
    opacity: 0;
  }

  @media screen and (max-width: 768px) {
    #projects-section {
      opacity: 100;
    }
  }
</style>
