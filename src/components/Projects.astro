---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import * as colores from "../../public/colors.json";

import type { ImageMetadata } from "astro";

type Colores = { [key: string]: string };

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{jpeg,jpg,png,gif,webp}",
);

const typedColores = colores as Colores;

const projects = [
  {
    name: ["Iberojet"],
    desc: "Primary frontend engineer of Iberojet's flight-booking website (Ávoris Travel). I bootstrapped its Nuxt 3 + TypeScript codebase in 2024 and built the booking funnel, the interactive seat map, online check-in and manage-my-booking, serving several country sites in three languages. I also own SSR performance and production observability.",
    year: "2024 - Present",
    source: "",
    img: "/src/assets/projects/iberojet.webp",
    link: "https://iberojet.com/",
    status: "done",
    languagesColor: ["Vue", "TypeScript", "JavaScript", "HTML", "CSS", "Vue"],
    languages: ["Vue", "TS", "JS", "HTML", "CSS", "Nuxt"],
  },
  {
    name: ["Planb"],
    desc: "Built the public booking site (Nuxt 3) and the back-office (Vue 3) of PlanB, Ávoris' experiences and gift-box platform: availability calendar, role-based access with SSO, SAP integration, and stock and order management.",
    year: "2024 - 2025",
    source: "",
    img: "/src/assets/projects/planb.webp",
    link: "https://planb.es/",
    status: "done",
    languagesColor: ["Vue", "TypeScript", "JavaScript", "HTML", "CSS", "Vue"],
    languages: ["Vue", "TS", "JS", "HTML", "CSS", "Nuxt"],
  },
  {
    name: ["Punto Bazar"],
    desc: "Inventory and sales dashboard built for my UTN programming diploma: stock and products, a cart with price, tax and shipping calculations, transaction analytics, low-stock alerts and multiple accounts. Open source.",
    year: "2023",
    source: "https://github.com/bbauti/dashboard",
    img: "/src/assets/projects/dashboard.webp",
    link: "",
    status: "done",
    languagesColor: ["HTML", "CSS", "SCSS", "JavaScript", "Svelte", "Vite"],
    languages: ["HTML", "CSS", "SCSS", "JS", "Svelte", "Vite"],
  },
  /*
  {
    name: ["Todo App"],
    desc: "Pagina web para gestionar tareas con el uso de localStorage.",
    source: "https://github.com/bbauti/p5todoapp",
    img: "todoapp",
    link: "https://bbauti.github.io/p5todoapp",
    status: "done",
    languagesColor: ["HTML", "CSS", "JavaScript"],
    languages: ["HTML", "CSS", "JS"],
  },
  {
    name: ["Weather Channel"],
    desc: "Pagina web para obtener informacion sobre el clima.",
    source: "https://github.com/bbauti/p5weatherChannel",
    img: "weatherchannel",
    link: "https://bbauti.github.io/p5weatherChannel",
    status: "done",
    languagesColor: ["HTML", "CSS", "JavaScript"],
    languages: ["HTML", "CSS", "JS"],
  },
  {
    name: ["Color Game"],
    desc: "Juego sobre adivinar un color en formato rgb, con cuadrados de colores aleatorios.",
    source: "https://github.com/bbauti/p5colorgame",
    img: "colorgame",
    link: "https://bbauti.github.io/p5colorgame",
    status: "done",
    languagesColor: ["HTML", "CSSimagePath", "JavaScript"],
    languages: ["HTML", "CSS", "JS"],
  }, */
];

const sideProjects = [
  {
    name: ["Impostor"],
    desc: "Real-time multiplayer social-deduction game (Nuxt 4, WebSockets, Supabase)",
    icon: "https://impostor.bbauti.ar/favicon.svg",
    source: "https://github.com/bbauti/impostor",
    link: "https://impostor.bbauti.ar/",
    status: "done",
  },
  {
    name: ["warframe-mcp"],
    desc: "MCP server on npm that gives LLM clients typed tools over game data",
    icon: "",
    source: "https://github.com/bbauti/warframe-mcp",
    link: "https://www.npmjs.com/package/@bbauti/warframe-mcp",
    status: "done",
  },
  {
    name: ["Gym Tracker"],
    desc: "Offline-first workout tracker for iOS and Android (Expo, SQLite)",
    icon: "",
    source: "https://github.com/bbauti/gym-tracker",
    link: "",
    status: "done",
  },
  {
    name: ["modtracker"],
    desc: "Tracks Modrinth projects and modpacks with live WebSocket updates (Nuxt 3)",
    icon: "",
    source: "https://github.com/bbauti/modtracker",
    link: "",
    status: "done",
  },
  {
    name: ["AtlassianBot"],
    desc: "CLI that turns Bitbucket and Jira activity into daily reports with LLMs",
    icon: "",
    source: "https://github.com/bbauti/atlassian-bot",
    link: "",
    status: "done",
  },
  {
    name: ["QPC-Tui"],
    desc: "Terminal UI news reader for a local news site, served over SSH (Go)",
    icon: "",
    source: "https://github.com/bbauti/qpc-tui",
    link: "",
    status: "wip",
  },
];

const checkColor = (lang: keyof Colores): string => {
  const color = typedColores[lang];
  return color ? color : "#fff";
};
---

<section class="mb-8" id="projects-section" aria-labelledby="projects-heading">
  <h2
    id="projects-heading"
    class="relative mx-auto mb-4 w-fit text-lg font-semibold md:text-xl"
  >
    Featured work
  </h2>
  <div id="cards" class="flex w-full flex-col items-center gap-4" role="list">
    {
      projects.map((project) => (
        <article
          class="h-fit w-fit overflow-hidden rounded-[30px] transition-all ease-in-out hover:shadow-xl"
          role="listitem"
        >
          <div class="relative mx-auto flex h-full w-full max-w-[1000px] flex-col justify-between gap-4 rounded-[30px] bg-[#f5f5f5] p-[0.8rem] shadow-project-outline md:flex-row dark:bg-[#121212] dark:shadow-project-outline-dark">
            <div class="flex w-full flex-col gap-2 p-[1rem] md:max-w-[34ch]">
              <header class="flex items-center gap-2 text-xl font-[600] select-none">
                <h3 class="ptitle">{project.name[0]}</h3>
                <div class="flex items-center gap-2">
                  {project.source && (
                    <div class="icon-card rounded-md bg-[#AFAFAF]/10 p-1 transition-all ease-in-out hover:-translate-y-[1px] hover:bg-[#AFAFAF]/40 dark:bg-[#4A4A4A]/10 dark:hover:bg-[#4A4A4A]/40">
                      <a
                        href={project.source}
                        class="git"
                        aria-label={`View source code of ${project.name[0]}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon name="mdi:git" />
                      </a>
                    </div>
                  )}
                  {project.status === "done" && project.link && (
                    <div class="icon-card icon-card-text hover:color-[#AFAFAF] dark:hover:color-[#4A4A4A] rounded-md bg-[#AFAFAF]/10 p-1 transition-all ease-in-out hover:-translate-y-[1px] dark:bg-[#4A4A4A]/10">
                      <a
                        href={project.link}
                        aria-label={`Visit ${project.name[0]}`}
                        class="done"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon name="mdi:external-link" />
                      </a>
                    </div>
                  )}
                  {project.status === "wip" && (
                    <div
                      class="icon-card disabled rounded-md bg-[#AFAFAF]/10 p-1 dark:bg-[#4A4A4A]/10"
                      role="img"
                      aria-label="Work in progress"
                    >
                      <Icon name="mdi:construction" aria-hidden="true" />
                    </div>
                  )}
                </div>
                <time class="ml-auto rounded-md bg-black/10 px-2 py-1 text-xs font-semibold opacity-50">
                  {project.year}
                </time>
              </header>
              <div
                class="flex flex-wrap gap-1 select-none"
                role="list"
                aria-label="Technologies used"
              >
                {project.languages.map((lang, index) => (
                  <div
                    class="flex items-center justify-center gap-1 rounded-lg border border-white/20 px-2 text-sm shadow-sm dark:border-black/20"
                    style={{
                      backgroundColor:
                        checkColor(project.languagesColor[index]) + "50",
                    }}
                    role="listitem"
                  >
                    <span
                      class="langColor"
                      style={{
                        color: checkColor(project.languagesColor[index]),
                      }}
                      aria-hidden="true"
                    >
                      ●
                    </span>
                    <span class="lang">{lang}</span>
                  </div>
                ))}
              </div>
              <div class="select-none">
                <p class="leading-[1.325] tracking-wide">{project.desc}</p>
              </div>
            </div>
            <figure class="my-auto h-fit w-fit">
              <Image
                src={images[project.img]()}
                alt={`Screenshot of ${project.name[0]}`}
                class="relative z-50 ml-auto max-h-full rounded-[25px] border border-gray-300 p-[0.1rem] dark:border-gray-600"
                width={500}
                height={375}
                densities={[1, 2]}
                loading="lazy"
                decoding="async"
                quality={80}
                format="webp"
              />
            </figure>
          </div>
        </article>
      ))
    }
  </div>
  <h3 class="mt-12 mb-4 text-center font-semibold md:text-lg">Side Projects</h3>
  <div
    id="side-project-cards"
    class="mx-auto grid max-w-220 grid-cols-1 gap-4 md:grid-cols-3"
    role="list"
  >
    {
      sideProjects.map((project) => (
        <article class="w-full rounded-lg border border-gray-500/20 p-4 shadow transition-all ease-in-out hover:shadow-lg">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              {project.icon && (
                <img
                  src={project.icon}
                  alt={project.name[0]}
                  class="h-6 w-6 rounded-md"
                />
              )}
              <p class="text-lg font-semibold">{project.name[0]}</p>
            </div>
            <div class="flex items-center gap-2">
              {project.source && (
                <div class="icon-card rounded-md bg-[#AFAFAF]/10 p-1 transition-all ease-in-out hover:-translate-y-[1px] hover:bg-[#AFAFAF]/40 dark:bg-[#4A4A4A]/10 dark:hover:bg-[#4A4A4A]/40">
                  <a
                    href={project.source}
                    class="git"
                    aria-label={`View source code of ${project.name[0]}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="mdi:git" />
                  </a>
                </div>
              )}
              {project.status === "done" && project.link && (
                <div class="icon-card icon-card-text hover:color-[#AFAFAF] dark:hover:color-[#4A4A4A] rounded-md bg-[#AFAFAF]/10 p-1 transition-all ease-in-out hover:-translate-y-[1px] dark:bg-[#4A4A4A]/10">
                  <a
                    href={project.link}
                    aria-label={`Visit ${project.name[0]}`}
                    class="done"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="mdi:external-link" />
                  </a>
                </div>
              )}
              {project.status === "wip" && (
                <div
                  class="icon-card disabled rounded-md bg-[#AFAFAF]/10 p-1 dark:bg-[#4A4A4A]/10"
                  role="img"
                  aria-label="Work in progress"
                >
                  <Icon name="mdi:construction" aria-hidden="true" />
                </div>
              )}
            </div>
          </div>
          <p class="text-sm">{project.desc}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  #projects-section {
    opacity: 0;
  }

  @media screen and (max-width: 768px) {
    #projects-section {
      opacity: 100;
    }
  }
</style>
